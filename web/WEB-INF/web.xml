<?xml version="1.0" encoding="UTF-8"?>

<web-app xmlns="http://java.sun.com/xml/ns/javaee" version="3.1">
    <servlet>
        <servlet-name>AdminPage</servlet-name>
        <jsp-file>/admin.jsp</jsp-file>
        <multipart-config>
            <location>/tmp</location>
            <max-file-size>10485760</max-file-size> <!-- 10 MB -->
            <max-request-size>20971520</max-request-size> <!-- 20 MB -->
            <file-size-threshold>5242880</file-size-threshold> <!-- 5 MB -->
        </multipart-config>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminPage</servlet-name>
        <url-pattern>/admin.jsp</url-pattern>
    </servlet-mapping>
</web-app>

